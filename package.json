{
  "name": "phone-webcam",
  "version": "2.0.0",
  "description": "Use your phone camera as a webcam on your PC via WiFi",
  "main": "src/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "start": "npm run build:vite && electron .",
    "build": "npm run build:vite && electron-builder",
    "build:win": "npm run build:vite && electron-builder --win",
    "build:mac": "npm run build:vite && electron-builder --mac",
    "build:linux": "npm run build:vite && electron-builder --linux"
  },
  "keywords": [
    "webcam",
    "phone",
    "camera",
    "electron",
    "wifi",
    "streaming",
    "virtual-camera"
  ],
  "author": {
    "name": "Phone Webcam",
    "email": "phonewebcam@localhost"
  },
  "homepage": "https://github.com/in100tiva/webcam",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "lucide-react": "^0.294.0",
    "qrcode": "^1.5.3",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "selfsigned": "^2.4.1",
    "tailwind-merge": "^2.1.0",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.14.2"
  },
  "build": {
    "appId": "com.phonewebcam.app",
    "productName": "Phone Webcam",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main.js",
      "src/preload.js",
      "src/virtualcam/**/*",
      "src/mobile/**/*",
      "dist-react/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "drivers/",
        "to": "drivers",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": ["deb", "AppImage"],
      "icon": "assets/icon.png",
      "category": "Video",
      "synopsis": "Use a câmera do celular como webcam via WiFi",
      "description": "Phone Webcam transforma a câmera do seu celular em uma webcam no PC via WiFi, com suporte a webcam virtual (Zoom, Meet, Teams) através do v4l2loopback."
    },
    "deb": {
      "depends": [
        "v4l2loopback-dkms",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libdrm2",
        "libgbm1"
      ],
      "afterInstall": "build/deb-postinstall.sh",
      "afterRemove": "build/deb-postremove.sh"
    }
  }
}
